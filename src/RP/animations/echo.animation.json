{
  "format_version": "1.8.0",
  "animations": {
    "animation.lastnight.echo.move": {
      "loop": true,
      "bones": {
        "head":      { "rotation": ["q.target_x_rotation", 0, 0] },
        "right_leg": { "rotation": ["math.cos(q.life_time * 500) * 38 * q.property('lastnight:walk')", 0, 0] },
        "left_leg":  { "rotation": ["-math.cos(q.life_time * 500) * 38 * q.property('lastnight:walk')", 0, 0] },
        "left_arm":  { "rotation": ["math.cos(q.life_time * 500) * 30 * q.property('lastnight:walk')", 0, 0] },
        "right_arm": { "rotation": ["q.property('lastnight:swing') ? (-50 - math.abs(math.sin(q.life_time * 900)) * 60) : (-math.cos(q.life_time * 500) * 30 * q.property('lastnight:walk'))", 0, 0] }
      }
    }
  }
}
