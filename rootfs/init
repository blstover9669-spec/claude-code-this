#!/bin/sh
# AI OS starter, PID 1. GRUB loads only this small system. It shows the loading screen (with
# games) while it reads the rest of AI OS, boot/system.img, from the disc or USB stick, then
# hands over to busybox init, which starts the chat. The text-mode boot entries give GRUB both
# archives, so everything is already here and the reading step is skipped.
export PATH=/sbin:/usr/sbin:/bin:/usr/bin
P=/sbin/ai-progress
MNT=/mnt/aios-boot

need_ram() {
  msg="
AI OS could not unpack itself into memory: this computer or VM needs more RAM.
Give it at least 1 GB (2 GB or more recommended) and start it again.
In VirtualBox: Settings > System > Motherboard > Base Memory = 2048 MB.
Powering off in 60 seconds."
  for t in /dev/tty1 /dev/console /dev/ttyS0; do   # the screen, and the serial console when used
    [ -w "$t" ] && echo "$msg" > "$t" 2>/dev/null
  done
  [ -w /dev/tty1 ] || [ -w /dev/console ] || echo "$msg"
  sleep 60; poweroff -f; sleep 3600
}

# Running out of memory while the kernel unpacks stops the archive part way. /init, the shell and
# poweroff come first in the starter and /.aios-complete comes last, so this check still works.
[ -x /sbin/init ] || need_ram

mount -t proc proc /proc; mount -t sysfs sys /sys
mount -t devtmpfs dev /dev 2>/dev/null; mkdir -p /dev/pts /dev/shm; mount -t devpts devpts /dev/pts
mount -t tmpfs tmp /tmp; mount -t tmpfs run /run
mkdir -p /run/aios
TEXT=0; grep -qw 'aios.text=1' /proc/cmdline && TEXT=1
mem=$(awk '/^MemTotal:/ { print int($2 / 1024) }' /proc/meminfo)
[ "${mem:-0}" -lt 880 ] && need_ram

coldplug() { find /sys/devices -name modalias -exec cat {} + 2>/dev/null | sort -u | xargs modprobe -qab 2>/dev/null; }

# A disc or USB stick holding this build of AI OS (boot/aios.id must match /etc/aios.id).
find_media() {
  for dev in $(ls /sys/class/block | grep -E '^sr' ; ls /sys/class/block | grep -vE '^(sr|loop|ram|zram|dm-)'); do
    [ -b "/dev/$dev" ] || continue
    mount -o ro -t iso9660 "/dev/$dev" "$MNT" 2>/dev/null || mount -o ro -t vfat "/dev/$dev" "$MNT" 2>/dev/null || continue
    if [ -f "$MNT/boot/system.img" ] && cmp -s "$MNT/boot/aios.id" /etc/aios.id; then
      echo "/dev/$dev"; return 0
    fi
    umount "$MNT" 2>/dev/null
  done
  return 1
}

# Streams boot/system.img through zstd and cpio into memory, moving the loading bar as it reads.
read_system() {
  img=$MNT/boot/system.img
  size=$(stat -c %s "$img")
  total=$(( (size + 524287) / 1048576 ))
  n=$(( (size + 4194303) / 4194304 ))          # 4 MiB pieces
  i=0
  {
    while [ "$i" -lt "$n" ]; do
      dd if="$img" bs=1M skip=$((i * 4)) count=4 2>/dev/null
      i=$((i + 1))
      got=$((i * 4)); [ "$got" -gt "$total" ] && got=$total
      $P $((5 + 75 * i / n)) "Loading AI OS" "$got of $total MB" </dev/null >/dev/null 2>&1
    done
  } | zstd -dcq | (cd / && cpio -idmu 2>/dev/null)
}

if [ ! -e /.aios-complete ]; then
  [ "$TEXT" = 1 ] && need_ram          # text-mode entries load everything up front: it ran out of memory
  echo /sbin/mdev > /proc/sys/kernel/hotplug
  modprobe -qa evdev psmouse usbhid hid_generic 2>/dev/null   # keyboard and mouse for the games
  # the loading screen with games when there is a graphical screen (it covers the text bar)
  $P --title
  if [ -e /dev/fb0 ] && [ -x /usr/bin/python3 ]; then
    PYTHONPATH=/usr/lib/aios setsid python3 -m aios.loader_ui </dev/null >/run/aios/loader-ui.log 2>&1 &
  fi
  $P 2 "Starting AI OS"
  coldplug
  modprobe -qa ata_piix ahci sr_mod sd_mod usb_storage uas virtio_blk virtio_scsi nvme hv_storvsc \
    vmw_pvscsi mptspi mmc_block isofs vfat nls_cp437 nls_iso8859_1 2>/dev/null
  mkdir -p "$MNT"
  tries=0
  until dev=$(find_media); do
    tries=$((tries + 1))
    [ "$tries" = 5 ] && coldplug      # controllers and USB sticks that showed up late
    if [ "$tries" -ge 90 ]; then
      $P --error "AI OS couldn't find its disc or USB stick. Restart and pick 'AI OS (text mode, no graphics)' in the boot menu."
      while :; do sleep 3600; done
    fi
    $P 4 "Looking for the AI OS disc or USB stick"
    sleep 1
  done
  $P 5 "Loading AI OS" "from $dev"
  read_system
  umount "$MNT" 2>/dev/null           # the USB stick can come out now: everything runs from memory
  if [ ! -e /.aios-complete ]; then
    $P --error "Reading AI OS from $dev failed part way. Restart and try again, or pick 'AI OS (text mode, no graphics)'."
    while :; do sleep 3600; done
  fi
  $P 80 "Starting up"
else
  $P --title
  $P 10 "Starting up"
fi

{
  echo '::sysinit:/sbin/ai-sysinit'
  if [ "$TEXT" = 0 ] && [ -x /usr/bin/aios-gui ]; then
    echo 'tty1::respawn:/usr/bin/aios-gui'
  else
    echo 'tty1::respawn:/usr/bin/aichat'
  fi
  grep -q 'console=ttyS0' /proc/cmdline && echo 'ttyS0::respawn:/usr/bin/aichat'
  echo '::ctrlaltdel:/sbin/reboot'
  echo '::shutdown:/bin/umount -a -r'
} > /etc/inittab
exec /sbin/init
