; Engine configuration file.
; Shroom Scramble — native Meta Quest build (Godot 4.4 + OpenXR).

config_version=5

[application]

config/name="Shroom Scramble"
config/description="Arm-powered tag on floating mushroom islands."
config/version="1.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.141, 0.086, 0.278, 1)
boot_splash/show_image=false

[audio]

general/default_playback_type.web=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.969, 0.788, 0.678, 1)

[xr]

openxr/enabled=true
openxr/reference_space=2
openxr/foveation_level=3
openxr/foveation_dynamic=true
openxr/startup_alert=false
shaders/enabled=true
